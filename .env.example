# Lead storage for the /api/request-service endpoint (Supabase REST).
# Any one valid pair works. Service role key is preferred (server-side only, never exposed).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fallbacks also supported:
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
